# OneContext - local environment
#
# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
#
# Only VITE_-prefixed variables are exposed to the browser. Never put a
# service-role key or GEMINI_API_KEY in this file - those are server-only and
# belong in Vercel project environment variables (added on Day 3).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
