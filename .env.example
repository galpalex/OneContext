# OneContext - local environment
#
# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).
#
# Only VITE_-prefixed variables are exposed to the browser, so a secret must never
# carry that prefix. Server-only values are fine in this file - `vercel dev` reads
# them for the serverless functions - but they must also be set in the Vercel
# project environment for a deployment. A Supabase service-role key belongs in
# neither: nothing in OneContext needs one.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Read by the /api/insight serverless function and never sent to the
# browser. Note the deliberate absence of a VITE_ prefix: that prefix is exactly
# what would publish it in the client bundle.
GEMINI_API_KEY=your-gemini-api-key
